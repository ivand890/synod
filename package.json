{
  "name": "@ivand890/synod",
  "version": "0.9.0",
  "description": "Install the Synod persistent advisor loop in Codex projects.",
  "type": "module",
  "bin": {
    "synod": "bin/synod.js"
  },
  "exports": {
    "./src/*.js": {
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "bin/",
    "dist/",
    "templates/",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "clean": "node --input-type=module -e \"import { rmSync } from 'node:fs'; rmSync(new URL('./dist/', import.meta.url), { recursive: true, force: true })\"",
    "build": "node --input-type=module -e \"import { rmSync } from 'node:fs'; rmSync(new URL('./dist/', import.meta.url), { recursive: true, force: true })\" && tsc -p tsconfig.build.json",
    "typecheck": "pnpm build && tsc -p tsconfig.json",
    "test": "pnpm typecheck && tsx scripts/test-suite.ts",
    "test:integration": "pnpm typecheck && tsx --test test/cli.test.ts",
    "test:package": "pnpm build && tsx scripts/package-smoke.ts",
    "test:codex-compatibility": "pnpm build && tsx scripts/codex-compatibility-smoke.ts",
    "prepack": "npm run build",
    "prepare": "npm run build"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "codex",
    "agents",
    "multi-agent",
    "advisor",
    "workflow"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ivand890/synod.git"
  },
  "bugs": {
    "url": "https://github.com/ivand890/synod/issues"
  },
  "homepage": "https://github.com/ivand890/synod#readme",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "pnpm@10.15.1",
  "devDependencies": {
    "@types/node": "20.19.43",
    "tsx": "4.23.12",
    "typescript": "7.0.2"
  }
}
